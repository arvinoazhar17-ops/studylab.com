"use strict";

// ========================================
// STUDYLAB AI — CLIENT-SIDE COMPLETE
// ========================================

// 🔑 MASUKKAN API KEY OPENAI KAMU DI SINI:
const OPENAI_API_KEY = "sk-proj-MASUKKAN_API_KEY_OPENAI_KAMU_DISINI";


// ========================================
// 1. ELEMENT REFERENCES
// ========================================

const menuToggle = document.getElementById("menuToggle");
const navLinks = document.getElementById("navLinks");

const generatorForm = document.getElementById("generatorForm");
const materiInput = document.getElementById("materiInput");
const characterCount = document.getElementById("characterCount");

const questionType = document.getElementById("questionType");
const questionCount = document.getElementById("questionCount");
const difficulty = document.getElementById("difficulty");

const generateButton = document.querySelector(".generate-button");

let formStatus = document.getElementById("formStatus");


// ========================================
// 2. MOBILE NAVIGATION
// ========================================

function closeMobileMenu() {
  if (!menuToggle || !navLinks) return;
  menuToggle.setAttribute("aria-expanded", "false");
  navLinks.classList.remove("active");
}

function toggleMobileMenu() {
  if (!menuToggle || !navLinks) return;
  const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
  menuToggle.setAttribute("aria-expanded", String(!isExpanded));
  navLinks.classList.toggle("active", !isExpanded);
}

if (menuToggle && navLinks) {
  menuToggle.addEventListener("click", toggleMobileMenu);
  navLinks.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });
}


// ========================================
// 3. CHARACTER COUNTER
// ========================================

function updateCharacterCount() {
  if (!materiInput || !characterCount) return;
  const totalCharacters = materiInput.value.length;
  characterCount.textContent = `${totalCharacters.toLocaleString("id-ID")} karakter`;
  characterCount.classList.toggle("is-empty", totalCharacters === 0);
  characterCount.classList.toggle("is-valid", totalCharacters >= 20);
}

if (materiInput) {
  materiInput.addEventListener("input", updateCharacterCount);
  updateCharacterCount();
}


// ========================================
// 4. FORM STATUS HELPER
// ========================================

if (generatorForm && !formStatus) {
  formStatus = document.createElement("p");
  formStatus.id = "formStatus";
  formStatus.className = "form-status";
  generatorForm.appendChild(formStatus);
}

function showFormStatus(message, type = "info") {
  if (!formStatus) return;
  formStatus.textContent = message;
  formStatus.dataset.status = type;
}


// ========================================
// 5. VALIDATE SETTINGS
// ========================================

function getStudySettings() {
  const materi = materiInput.value.trim();

  if (materi.length < 20) {
    showFormStatus("Masukkan materi minimal 20 karakter.", "error");
    materiInput.focus();
    return null;
  }

  if (materi.length > 15000) {
    showFormStatus("Materi terlalu panjang. Maksimal 15.000 karakter.", "error");
    materiInput.focus();
    return null;
  }

  return {
    materi,
    jenisSoal: questionType.value,
    jumlahSoal: Number(questionCount.value),
    kesulitan: difficulty.value
  };
}


// ========================================
// 6. QUIZ STATE & VARIABLES
// ========================================

const quizSection = document.getElementById("area-kuis");
const quizCard = document.getElementById("quizCard");
const quizResult = document.getElementById("quizResult");

const questionText = document.getElementById("questionText");
const questionLabel = document.getElementById("questionLabel");
const answerOptions = document.getElementById("answerOptions");
const answerFeedback = document.getElementById("answerFeedback");

const questionProgress = document.getElementById("questionProgress");
const answeredProgress = document.getElementById("answeredProgress");
const quizProgressBar = document.getElementById("quizProgressBar");
const quizProgressFill = document.getElementById("quizProgressFill");

const previousQuestion = document.getElementById("previousQuestion");
const nextQuestion = document.getElementById("nextQuestion");

const exitQuiz = document.getElementById("exitQuiz");
const retryQuiz = document.getElementById("retryQuiz");
const backToGenerator = document.getElementById("backToGenerator");

const finalScore = document.getElementById("finalScore");
const resultSummary = document.getElementById("resultSummary");
const answerReview = document.getElementById("answerReview");

let quizQuestions = [];
let currentQuestionIndex = 0;
let userAnswers = [];
let quizSettings = null;
let quizFinished = false;


// ========================================
// 7. START QUIZ
// ========================================

function startQuiz(questions, settings = {}) {
  quizQuestions = questions;
  quizSettings = settings;
  currentQuestionIndex = 0;
  userAnswers = Array(quizQuestions.length).fill(null);
  quizFinished = false;

  quizSection.hidden = false;
  quizCard.hidden = false;
  quizResult.hidden = true;

  document.getElementById("quizTitle").textContent = "Latihan Soal AI";
  document.getElementById("quizDescription").textContent = `${quizQuestions.length} soal · ${settings.kesulitan}`;

  renderQuestion();

  quizSection.scrollIntoView({ behavior: "smooth", block: "start" });
}


// ========================================
// 8. RENDER QUESTION
// ========================================

function renderQuestion() {
  if (!quizQuestions.length || quizFinished) return;

  const question = quizQuestions[currentQuestionIndex];
  const selectedAnswer = userAnswers[currentQuestionIndex];

  questionLabel.textContent = `PERTANYAAN ${String(currentQuestionIndex + 1).padStart(2, "0")}`;
  questionText.textContent = question.question;

  answerOptions.replaceChildren();

  question.options.forEach((option, index) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "answer-option";
    button.textContent = `${String.fromCharCode(65 + index)}. ${option}`;

    if (selectedAnswer === index) {
      button.classList.add("is-selected");
    }

    button.addEventListener("click", () => {
      if (quizFinished) return;
      userAnswers[currentQuestionIndex] = index;
      renderQuestion();
    });

    answerOptions.appendChild(button);
  });

  const answered = userAnswers.filter(a => a !== null).length;
  questionProgress.textContent = `Soal ${currentQuestionIndex + 1} dari ${quizQuestions.length}`;
  answeredProgress.textContent = `${answered} dijawab`;

  const progress = ((currentQuestionIndex + 1) / quizQuestions.length) * 100;
  if (quizProgressFill) quizProgressFill.style.width = `${progress}%`;

  previousQuestion.disabled = currentQuestionIndex === 0;
  nextQuestion.textContent = currentQuestionIndex === quizQuestions.length - 1 ? "Selesaikan latihan" : "Berikutnya";
  
  answerFeedback.textContent = selectedAnswer === null ? "Pilih jawaban yang menurutmu benar." : "Jawaban tersimpan.";
}


// ========================================
// 9. NAVIGATION
// ========================================

if (previousQuestion) {
  previousQuestion.addEventListener("click", () => {
    if (currentQuestionIndex > 0 && !quizFinished) {
      currentQuestionIndex--;
      renderQuestion();
    }
  });
}

if (nextQuestion) {
  nextQuestion.addEventListener("click", () => {
    if (quizFinished) return;

    if (userAnswers[currentQuestionIndex] === null) {
      answerFeedback.textContent = "Pilih jawaban terlebih dahulu sebelum melanjutkan.";
      return;
    }

    if (currentQuestionIndex < quizQuestions.length - 1) {
      currentQuestionIndex++;
      renderQuestion();
    } else {
      finishQuiz();
    }
  });
}


// ========================================
// 10. FINISH QUIZ & SCORE
// ========================================

function finishQuiz() {
  if (quizFinished) return;
  quizFinished = true;

  const correct = quizQuestions.filter((q, i) => userAnswers[i] === q.answer).length;
  const total = quizQuestions.length;
  const score = Math.round((correct / total) * 100);

  quizCard.hidden = true;
  quizResult.hidden = false;

  finalScore.textContent = `${score}%`;
  resultSummary.textContent = `Kamu menjawab ${correct} dari ${total} soal dengan benar.`;

  renderAnswerReview();
  saveQuizHistory({ date: new Date().toISOString(), subject: quizSettings.materi.slice(0, 50) + "...", score, correct, total });

  quizResult.scrollIntoView({ behavior: "smooth", block: "start" });
}


// ========================================
// 11. REVIEW & HISTORY
// ========================================

function renderAnswerReview() {
  answerReview.replaceChildren();

  quizQuestions.forEach((q, i) => {
    const item = document.createElement("article");
    const isCorrect = userAnswers[i] === q.answer;
    item.className = `answer-review-item ${isCorrect ? "is-correct" : "is-incorrect"}`;

    item.innerHTML = `
      <h4>${i + 1}. ${q.question}</h4>
      <p><b>Jawabanmu:</b> ${userAnswers[i] !== null ? q.options[userAnswers[i]] : "Tidak dijawab"}</p>
      <p><b>Jawaban benar:</b> ${q.options[q.answer]}</p>
      <p><small><b>Pembahasan:</b> ${q.explanation || "Tidak ada pembahasan."}</small></p>
    `;
    answerReview.appendChild(item);
  });
}

function saveQuizHistory(entry) {
  try {
    const history = JSON.parse(localStorage.getItem("studylab-history") || "[]");
    history.unshift(entry);
    localStorage.setItem("studylab-history", JSON.stringify(history.slice(0, 20)));
    renderQuizHistory();
  } catch (e) {
    console.error(e);
  }
}

function renderQuizHistory() {
  const historyList = document.getElementById("historyList");
  const historyEmpty = document.getElementById("historyEmpty");
  if (!historyList || !historyEmpty) return;

  try {
    const history = JSON.parse(localStorage.getItem("studylab-history") || "[]");
    historyList.replaceChildren();

    if (history.length === 0) {
      historyEmpty.hidden = false;
      historyList.hidden = true;
      return;
    }

    historyEmpty.hidden = true;
    historyList.hidden = false;

    history.forEach(entry => {
      const card = document.createElement("article");
      card.className = "history-item";
      card.innerHTML = `
        <div>
          <h3>${entry.subject}</h3>
          <p>${entry.correct}/${entry.total} benar · ${new Date(entry.date).toLocaleDateString("id-ID")}</p>
        </div>
        <strong>${entry.score}%</strong>
      `;
      historyList.appendChild(card);
    });
  } catch (e) {
    historyEmpty.hidden = false;
  }
}


// ========================================
// 12. BUTTON ACTIONS
// ========================================

if (retryQuiz) retryQuiz.addEventListener("click", () => startQuiz(quizQuestions, quizSettings));
if (backToGenerator || exitQuiz) {
  const backAction = () => { quizSection.hidden = true; document.getElementById("buat-latihan").scrollIntoView({ behavior: "smooth" }); };
  if (backToGenerator) backToGenerator.addEventListener("click", backAction);
  if (exitQuiz) exitQuiz.addEventListener("click", backAction);
}


// ========================================
// 13. OPENAI GENERATOR SUBMISSION
// ========================================

if (generatorForm) {
  generatorForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const settings = getStudySettings();
    if (!settings) return;

    if (OPENAI_API_KEY.includes("MASUKKAN_API_KEY")) {
      showFormStatus("Tolong masukkan API Key OpenAI kamu di baris atas file script.js terlebih dahulu!", "error");
      return;
    }

    const originalText = generateButton.textContent;

    try {
      generateButton.disabled = true;
      generateButton.textContent = "AI sedang menyusun soal...";
      showFormStatus("Menganalisis materi dan membuat kuis interaktif...", "info");

      const promptSystem = `Kamu adalah StudyLab AI, pembuat latihan soal pendidikan untuk pelajar. 
Berikan output berupa JSON murni tanpa teks pengantar dengan struktur:
{
  "questions": [
    {
      "question": "Pertanyaan?",
      "options": ["A", "B", "C", "D"],
      "answer": 0,
      "explanation": "Penjelasan"
    }
  ]
}
Ketentuan: Bahasa Indonesia, tepat ${settings.jumlahSoal} soal, tingkat kesulitan ${settings.kesulitan}. 'answer' berupa indeks 0-3.`;

      const response = await fetch("https://api.openai.com/v1/chat/completions", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${OPENAI_API_KEY}`
        },
        body: JSON.stringify({
          model: "gpt-4o-mini",
          response_format: { type: "json_object" },
          messages: [
            { role: "system", content: promptSystem },
            { role: "user", content: `Materi:\n${settings.materi}` }
          ],
          temperature: 0.7
        })
      });

      const data = await response.json();
      if (!response.ok) throw new Error(data.error?.message || "Gagal terhubung ke OpenAI.");

      const result = JSON.parse(data.choices[0].message.content);
      if (!result || !Array.isArray(result.questions)) throw new Error("Format soal dari AI tidak valid.");

      startQuiz(result.questions, settings);
      showFormStatus("Latihan berhasil dibuat!", "success");

    } catch (error) {
      console.error(error);
      showFormStatus(error.message || "Gagal membuat soal. Coba lagi.", "error");
    } finally {
      generateButton.disabled = false;
      generateButton.textContent = originalText;
    }
  });
}

renderQuizHistory();
